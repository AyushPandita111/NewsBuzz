# Frontend build-time configuration (Create React App).
# Copy to .env for local overrides. Variables MUST be prefixed with REACT_APP_.

# URL of the deployed backend API. Leave unset locally to use http://localhost:9000.
# In Vercel, set this to your Render backend URL (must be https), e.g.:
# REACT_APP_BACKEND_API=https://your-app.onrender.com
REACT_APP_BACKEND_API=
